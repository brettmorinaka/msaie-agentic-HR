# LLM Provider Configuration
# Set OPENAI_API_KEY, ANTHROPIC_API_KEY, or GOOGLE_API_KEY if using a live LLM
# If no key is set, the system seamlessly uses the built-in deterministic HR Mock LLM for offline testing & evaluations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_TRANSPORT=http

# Fast API Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Configuration
STREAMLIT_PORT=8501

# Storage Paths
DATA_DIR=./data
CHROMA_PERSIST_DIR=./chroma_db
RANDOM_SEED=42
