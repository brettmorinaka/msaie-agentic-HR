# LLM Provider Configuration (OpenRouter is the chosen primary LLM provider)
# Set OPENROUTER_API_KEY to call models via OpenRouter (e.g., openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct)
# If no key is set, the system seamlessly uses the built-in deterministic HR Mock LLM for offline testing & evaluations
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

# Optional Direct Fallback Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=


# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_TRANSPORT=http

# Fast API Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Configuration
STREAMLIT_PORT=8501

# Storage Paths
DATA_DIR=./data
CHROMA_PERSIST_DIR=./chroma_db
RANDOM_SEED=42
